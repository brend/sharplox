{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Lox REPL",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/bin/Debug/net10.0/lox.dll",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Debug Lox Script",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/bin/Debug/net10.0/lox.dll",
      "args": ["${input:loxScript}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    }
  ],
  "inputs": [
    {
      "id": "loxScript",
      "type": "promptString",
      "description": "Path to .lox script file",
      "default": "${workspaceFolder}/scratch.lox"
    }
  ]
}
